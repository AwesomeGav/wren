font=IBM Plex Sans 11
background-color=#FFFFFFEE
text-color=#1E2328
border-color=#C9D0D6
border-size=1
border-radius=18
progress-color=over #0F7B8340
padding=14,16
margin=14
outer-margin=6
width=370
anchor=top-right
# On the overlay layer, so they fade in and out
layer=overlay
default-timeout=5000
max-visible=4
icons=1
max-icon-size=40
format=<b>%s</b>\n%b

[urgency=high]
border-color=#0F7B83
border-size=2
default-timeout=0

[mode=do-not-disturb]
invisible=1
