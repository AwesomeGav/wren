{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "spacing": 0,
  "modules-left": [
    "custom/apps",
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "group/status",
    "clock",
    "custom/power"
  ],
  "custom/apps": {
    "format": "󰀻",
    "tooltip": false,
    "on-click": "wren-shell launcher"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 24,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize-raise"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "format-disabled": "󰖪",
    "tooltip-format-wifi": "{essid}",
    "tooltip-format-ethernet": "Wired connection",
    "tooltip-format-disconnected": "Not connected",
    "on-click": "wren-shell control"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "Volume {volume}%",
    "scroll-step": 5,
    "on-click": "wren-shell control"
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}",
    "on-click": "wren-shell control"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %B %d, %Y}",
    "on-click": "wren-shell control"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wren-shell control"
  },
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 8,
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio",
      "battery"
    ]
  }
}
