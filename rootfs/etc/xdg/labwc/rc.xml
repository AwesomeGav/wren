<?xml version="1.0"?>
<!-- Wren Linux window manager settings (labwc). Everything works with the mouse;
     shortcuts below are optional extras. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>8</gap>
    <adaptiveSync>no</adaptiveSync>
  </core>

  <theme>
    <cornerRadius>14</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow"><name>IBM Plex Sans</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>IBM Plex Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>IBM Plex Sans</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>IBM Plex Sans</name><size>11</size></font>
  </theme>

  <!-- Drag a window to the top edge to maximize, to a side to fill half the screen -->
  <snapping>
    <range inner="12" outer="12" />
    <topMaximize>yes</topMaximize>
  </snapping>

  <placement>
    <policy>center</policy>
  </placement>

  <!-- Apps that draw their own modern title bars don't get a second one -->
  <windowRules>
    <windowRule identifier="org.gnome.*" serverDecoration="no" />
    <windowRule identifier="org.wrenlinux.*" serverDecoration="no" />
    <windowRule identifier="network.cycles.wdisplays" serverDecoration="no" />
  </windowRules>

  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="wren-shell launcher" /></keybind>
    <keybind key="W-space"><action name="Execute" command="wren-shell launcher" /></keybind>
    <keybind key="W-a"><action name="Execute" command="wren-shell control" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="wren-terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="nautilus --new-window" /></keybind>
    <keybind key="W-l"><action name="Execute" command="wren-lock" /></keybind>
    <keybind key="Print"><action name="Execute" command="wren-screenshot" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wren-osd volume up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wren-osd volume down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wren-osd volume mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="wren-osd brightness up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="wren-osd brightness down" /></keybind>
  </keyboard>

  <libinput>
    <device category="touchpad">
      <tap>yes</tap>
      <naturalScroll>yes</naturalScroll>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>
</labwc_config>
