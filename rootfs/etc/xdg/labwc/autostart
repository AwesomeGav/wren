# Started once when the Wren desktop starts.
xdg-user-dirs-update >/dev/null 2>&1

# First login: tell GNOME/libadwaita apps to use Wren's dark style and fonts
if [ ! -f "$HOME/.config/wren/defaults-v3" ]; then
  gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark
  gsettings set org.gnome.desktop.interface icon-theme Wren
  gsettings set org.gnome.desktop.interface font-name 'Inter 10'
  gsettings set org.gnome.desktop.interface document-font-name 'Inter 10'
  gsettings set org.gnome.desktop.interface accent-color orange
  gsettings set org.gnome.desktop.interface enable-animations false
  gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close'
  gsettings set org.gnome.TextEditor style-scheme 'wren-dark'
  gsettings set org.gnome.TextEditor style-variant 'dark'
  mkdir -p "$HOME/.config/wren" && touch "$HOME/.config/wren/defaults-v3"
fi
mkdir -p "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"
[ -f "$HOME/.config/gtk-3.0/gtk.css" ] || cp /etc/skel/.config/gtk-3.0/gtk.css "$HOME/.config/gtk-3.0/"
# GTK 3 apps get the GTK 3-only palette file (older installs pointed at the GTK 4 one)
sed -i 's#/usr/share/wren/gtk.css#/usr/share/wren/gtk3.css#' "$HOME/.config/gtk-3.0/gtk.css" 2>/dev/null
[ -f "$HOME/.config/gtk-4.0/gtk.css" ] || cp /etc/skel/.config/gtk-4.0/gtk.css "$HOME/.config/gtk-4.0/"

swaybg -i /usr/share/wren/wallpaper.jpg -m fill >/dev/null 2>&1 &
waybar -c /etc/xdg/wren/waybar/config.jsonc -s /etc/xdg/wren/waybar/style.css >/dev/null 2>&1 &
mako -c /etc/xdg/wren/mako/config >/dev/null 2>&1 &
wren-shell --service >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &

if [ -d /run/archiso ]; then
  # Live USB: open the installer welcome screen
  (sleep 2; wren-installer) >/dev/null 2>&1 &
else
  wren-update-notify >/dev/null 2>&1 &
  # Lock after 10 idle minutes and before sleeping
  swayidle -w \
    timeout 600 'pidof hyprlock || hyprlock -c /etc/xdg/wren/hypr/hyprlock.conf &' \
    before-sleep 'pidof hyprlock || hyprlock -c /etc/xdg/wren/hypr/hyprlock.conf &' >/dev/null 2>&1 &
fi
