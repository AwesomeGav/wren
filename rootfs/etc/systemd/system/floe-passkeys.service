[Unit]
Description=Floe Passkeys (built-in passkey security key)
After=systemd-udevd.service systemd-modules-load.service

[Service]
Type=simple
Environment=PYTHONPATH=/usr/lib/wren PYTHONUNBUFFERED=1
ExecStartPre=-/usr/bin/modprobe uhid
ExecStart=/usr/bin/python3 -m passkeys --system
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
