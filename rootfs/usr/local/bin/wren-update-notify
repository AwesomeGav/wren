#!/bin/sh
# Checks for a Floe update shortly after login and shows a notification if one is ready.
[ -d /run/archiso ] && exit 0
sleep 90
# Battery saver: no background downloads
[ -f "$HOME/.cache/wren/battery-saver" ] && exit 0
cache="$HOME/.cache/wren"
mkdir -p "$cache"
result=$(wren-update --check 2>/dev/null)
case "$result" in
  available*)
    echo "${result#available }" > "$cache/update-available"
    notify-send -a Floe -i floe-logo "A Floe update is ready" \
      "Open quick settings and click Updates to install it."
    ;;
  current*) rm -f "$cache/update-available" ;;
esac
