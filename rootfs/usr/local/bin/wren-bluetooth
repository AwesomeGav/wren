#!/bin/sh
# Reuses the running app when there is one (instant), otherwise starts it.
if [ $# -eq 0 ]; then
  gdbus call --session --dest org.wrenlinux.Bluetooth --object-path /org/wrenlinux/Bluetooth \
    --method org.freedesktop.Application.Activate '{}' >/dev/null 2>&1 && exit 0
fi
exec env PYTHONPATH=/usr/lib/wren python3 -m bluetooth "$@"
