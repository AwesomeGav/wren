#!/bin/sh
# A new window in the running terminal app when there is one (instant).
if [ $# -eq 0 ]; then
  gdbus call --session --dest org.wrenlinux.Terminal --object-path /org/wrenlinux/Terminal \
    --method org.freedesktop.Application.ActivateAction new-window '[]' '{}' >/dev/null 2>&1 && exit 0
fi
exec env PYTHONPATH=/usr/lib/wren python3 -m terminal "$@"
