#!/bin/sh
# Locks the screen / puts the computer to sleep after the times chosen in Settings.
# WREN_SAVER_AFTER, WREN_LOCK_AFTER and WREN_SLEEP_AFTER are in seconds; 0 means never.
WREN_SAVER_AFTER=60
WREN_LOCK_AFTER=600
WREN_SLEEP_AFTER=0
[ -r "$HOME/.config/wren/settings.env" ] && . "$HOME/.config/wren/settings.env"
pkill -x swayidle 2>/dev/null
if [ -d /run/archiso ]; then  # live USB: never lock or sleep
  WREN_LOCK_AFTER=0 WREN_SLEEP_AFTER=0
  [ -f "$HOME/.cache/wren/battery-saver" ] || exit 0
fi
LOCK='wren-lock &'
set -- -w
# Screen saver: any use of the computer ends it (and it ends itself too)
[ "$WREN_SAVER_AFTER" -gt 0 ] 2>/dev/null && \
  set -- "$@" timeout "$WREN_SAVER_AFTER" 'wren-screensaver &' resume 'wren-screensaver --stop'
[ "$WREN_LOCK_AFTER" -gt 0 ] 2>/dev/null && set -- "$@" timeout "$WREN_LOCK_AFTER" "$LOCK"
[ "$WREN_SLEEP_AFTER" -gt 0 ] 2>/dev/null && set -- "$@" timeout "$WREN_SLEEP_AFTER" 'systemctl suspend'
# Battery saver: dim the screen after 1 minute of no use
if [ -f "$HOME/.cache/wren/battery-saver" ]; then
  set -- "$@" timeout 60 'brightnessctl -q -s -c backlight set 10%' resume 'brightnessctl -q -r -c backlight'
fi
exec swayidle "$@" before-sleep "$LOCK"
