<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Wren Linux</vendor>
  <action id="org.wrenlinux.battery-saver">
    <description>Turn Battery saver on or off</description>
    <message>Battery saver needs permission to change power settings</message>
    <icon_name>battery-caution</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/wren/power-helper.sh</annotate>
  </action>
</policyconfig>
