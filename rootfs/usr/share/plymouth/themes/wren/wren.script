# Wren start-up screen: logo, name and a spinning ring on the Wren background.
Window.SetBackgroundTopColor(0.078, 0.071, 0.063);
Window.SetBackgroundBottomColor(0.078, 0.071, 0.063);

logo.image = Image("logo.png");
word.image = Image("wordmark.png");
ring.image = Image("spinner.png");

logo.sprite = Sprite(logo.image);
word.sprite = Sprite(word.image);
ring.sprite = Sprite();
ring.angle = 0;

# Recentred every frame: the screen size can change while booting
fun refresh_callback() {
  cx = Window.GetX() + Window.GetWidth() / 2;
  cy = Window.GetY() + Window.GetHeight() / 2;
  logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() - 20, 1);
  word.sprite.SetPosition(cx - word.image.GetWidth() / 2, cy + 6, 1);
  ring.angle += 0.10;
  rotated = ring.image.Rotate(ring.angle);
  ring.sprite.SetImage(rotated);
  ring.sprite.SetPosition(cx - rotated.GetWidth() / 2, cy + 110, 1);
}
Plymouth.SetRefreshFunction(refresh_callback);

# Hide boot messages; keep the screen clean
fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);
